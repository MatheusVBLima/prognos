# Public URL of the app, used in auth redirect links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase secret key, only for the daily trend job (Project Settings > API keys). Never expose it to the browser.
SUPABASE_SECRET_KEY=

# AI: scripts, brand analysis, trend ideas and web news search (Google AI Studio)
GEMINI_API_KEY=

# Trend sources (each one is optional; missing keys just skip that source)
# Google Trends through SerpAPI: https://serpapi.com
SERPAPI_API_KEY=
# YouTube Data API v3 key from Google Cloud Console
YOUTUBE_API_KEY=

# Protects the daily trend job; Vercel Cron sends it automatically when set in the project
CRON_SECRET=

# Text-to-speech
OPENAI_API_KEY=

# Browserbase (remote browser, used for website and trend scraping)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
